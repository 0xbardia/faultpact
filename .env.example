NODE_ENV=development
DATABASE_URL=postgresql://faultpact:faultpact@127.0.0.1:5432/faultpact?schema=public

GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
GENLAYER_CHAIN_ID=61997
FAULTPACT_CONTRACT_ADDRESS=0xeb858957e3C426597245f6b59E260f1cC556Bf13
FAULTPACT_SOURCE_SHA256=4913a2af9cac39aac211f8f9fa66e1de8791986db495585c7a1ee9f757e7bb2e

API_HOST=127.0.0.1
API_PORT=4310

INDEXER_POLL_INTERVAL_MS=300000
INDEXER_RECONCILE_INTERVAL_MS=1800000
INDEXER_RECONCILE_LIMIT=10

# Shared by the API and worker. In production the transport defaults to
# .runtime/studio-rpc-scheduler.json under the service working directory.
GENLAYER_RPC_MIN_INTERVAL_MS=3000
GENLAYER_RPC_DAILY_BUDGET=1400
GENLAYER_RPC_BUDGET_STATE_FILE=
GENLAYER_RPC_METRICS_INTERVAL_MS=300000
GENLAYER_RPC_PROBE_INTERVAL_MS=1800000

PROBE_REGION=frankfurt
# This remains 30 seconds for non-GenLayer infrastructure probes.
PROBE_INTERVAL_MS=30000
PROBE_TIMEOUT_MS=5000
PROBE_HTTP_ALLOWED=false
PROBE_MAX_RESPONSE_BYTES=262144
PROBE_RAW_RETENTION_SECONDS=604800
PROBE_REFERENCE_RPC_URL=

EVIDENCE_PUBLIC_BASE_URL=https://faultpact.bydx.fun/evidence
EVIDENCE_MAX_BYTES=65536

ADMIN_API_TOKEN=
REPORTER_PRIVATE_KEY=
# Optional key-rotation guard: the signer must derive exactly this public address.
REPORTER_EXPECTED_ADDRESS=
# submit_evidence type used by the signer-backed evidence command. An authorized
# reporter submitting an authoritative type (PROBE_REPORT, THIRD_PARTY_MONITOR,
# CHAIN_REFERENCE) receives AUTHORITATIVE provenance in the frozen contract.
REPORTER_SUBMIT_EVIDENCE_TYPE=THIRD_PARTY_MONITOR
# Bounded per-transaction finalization wait. A timeout is NOT VERIFIED, never PASS.
REPORTER_MAX_FINALIZATION_WAIT_MS=240000
# Explicit OPEN incident for `pnpm evidence:submit` and `pnpm test:reporter-live`.
FAULTPACT_LIVE_TEST_INCIDENT_ID=
AUTO_ONCHAIN_SUBMISSION=false
MONITOR_MODE=observe

LOG_LEVEL=info

# Frontend (public values only)
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://faultpact.bydx.fun
NEXT_PUBLIC_CHAIN_ID=61997
NEXT_PUBLIC_CONTRACT_ADDRESS=0xeb858957e3C426597245f6b59E260f1cC556Bf13
BACKEND_API_URL=http://127.0.0.1:4310
